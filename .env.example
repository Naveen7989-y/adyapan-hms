# ============================================================
# Adyapan HMS - Docker Compose Environment Configuration
# Copy this file to .env and adjust values for your deployment
# ============================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_DB=adyapan_hms
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend API Configuration
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_hex_string
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173

# Healthcare Discovery - Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Database Seeding
# Set to 'true' to automatically seed initial hospital, roles, and master users on first container start
SEED_ON_BOOT=true
