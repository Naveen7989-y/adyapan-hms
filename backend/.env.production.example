# ============================================================
# Adyapan HMS - Production Backend Environment Variables
# Copy to .env.production or configure in your Cloud Provider Dashboard
# (Render / Railway / Supabase / Fly.io / AWS)
# ============================================================

PORT=5000
NODE_ENV=production

# Database (PostgreSQL Connection String with pooling)
# Example for Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Example for Render: postgres://[user]:[password]@[host]/[database]
DATABASE_URL="postgresql://username:strong_password@host:5432/adyapan_hms?schema=public&sslmode=prefer"

# Security & Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate_secure_random_32_byte_secret_key"
JWT_REFRESH_SECRET="generate_secure_random_32_byte_refresh_key"
JWT_EXPIRES_IN="1d"

# Allowed Frontend Origins (comma-separated or single domain)
# Example: https://app.adyapan.com,https://adyapan-hms.vercel.app
FRONTEND_URL="https://your-frontend-domain.com"

# Cache & In-Memory Store
REDIS_URL="redis://default:password@redis-host:6379"

# Notification Providers (Optional production integrations)
# MSG91 SMS Provider
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="ADYPAN"
MSG91_TEMPLATE_ID=""

# Twilio SMS / WhatsApp Provider
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Automatic seed on first start (set to 'false' after initial deployment)
SEED_ON_BOOT=true
